[ENTRY]
CATEGORY=Games
NAME=Stardew Valley
DESCRIPTION=Stardew Valley 1.6.15.24356 Steam Compatibility (32-bit/XNA)
ICON=/home/player/ports/stardewvalley/icon.png
COMMAND=sh /home/player/ports/stardewvalley/stardew.sh
